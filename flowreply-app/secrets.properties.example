# Copy this file to `secrets.properties` (which is git-ignored) and fill in your
# own values. The build injects them into BuildConfig; they are NOT committed.
#
# Comma-separated list of Gemini API keys (rotated at runtime).
GEMINI_API_KEYS=your_key_1,your_key_2
# Optional: override the default Gemini model.
GEMINI_MODEL=gemini-2.5-flash
