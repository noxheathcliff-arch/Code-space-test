<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- All traffic requires TLS. (The legacy v1.7 config allowed cleartext to
         the Gemini host; that is removed — HTTPS only.) -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
