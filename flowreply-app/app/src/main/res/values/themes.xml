<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base theme: the UI itself is Jetpack Compose (Material3), so this only
         needs to provide a no-action-bar window. Colors come from Compose. -->
    <style name="Theme.FlowReply" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
